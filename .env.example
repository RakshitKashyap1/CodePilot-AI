# Django settings
SECRET_KEY=generate-a-real-secret-key-via-django.core.management.utils.get_random_secret_key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database settings (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=codepilot_db
DB_USER=codepilot_user
DB_PASSWORD=codepilot_password
DB_HOST=localhost
DB_PORT=5432

# Redis and Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Provider (gemini or huggingface)
AI_PROVIDER=huggingface

# AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face (used when AI_PROVIDER=huggingface)
HF_API_TOKEN=your_hf_api_token_here
HF_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# Google OAuth
GOOGLE_OAUTH2_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH2_CLIENT_SECRET=your_google_client_secret

# GitHub Integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
